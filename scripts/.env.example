# Copy to .env for LOCAL testing (never commit .env). In production these
# are GitHub repo Secrets; GH_USER is a repo Variable.
# (Names cannot start with GITHUB_ — that prefix is reserved by GitHub.)
#
#   node --env-file=.env build-live.mjs     # local test (Node 20+)

# --- Spotify moved to worker/ (a Cloudflare Worker; see worker/README.md) ---

# --- Steam (most-played game, last 2 weeks). Profile must be public. ---
STEAM_API_KEY=               # https://steamcommunity.com/dev/apikey
STEAM_ID=                    # your SteamID64 (17 digits)

# --- PSN (optional; most recently played). Fragile/unofficial. ---
PSN_NPSSO=                   # 64-char npsso; leave blank to skip PSN entirely

# --- GitHub (latest public activity). No secret needed. ---
GH_USER=                     # your GitHub username
# GH_TOKEN is supplied automatically by the Action (raises the rate limit)
